# Copy this file to .env when local configuration is required.
# Never place real credentials or secrets in this template.

RECONCILEFLOW_ENVIRONMENT=development
RECONCILEFLOW_DEBUG=false
RECONCILEFLOW_API_PREFIX=/api/v1
RECONCILEFLOW_LOG_LEVEL=INFO
RECONCILEFLOW_DATABASE_URL=postgresql+psycopg://reconcileflow:change-me@localhost:5432/reconcileflow
RECONCILEFLOW_DATABASE_ECHO=false
RECONCILEFLOW_DATABASE_POOL_SIZE=5
RECONCILEFLOW_DATABASE_MAX_OVERFLOW=10
RECONCILEFLOW_DATABASE_POOL_TIMEOUT_SECONDS=30
RECONCILEFLOW_UPLOAD_DIRECTORY=var/uploads
RECONCILEFLOW_STORAGE_PROVIDER=local
RECONCILEFLOW_S3_ENDPOINT_URL=http://localhost:9000
RECONCILEFLOW_S3_REGION=us-east-1
RECONCILEFLOW_S3_BUCKET=reconcileflow-uploads
RECONCILEFLOW_S3_ACCESS_KEY_ID=local-minio-user
RECONCILEFLOW_S3_SECRET_ACCESS_KEY=replace-with-a-local-minio-password
RECONCILEFLOW_S3_USE_PATH_STYLE=true
RECONCILEFLOW_S3_CONNECT_TIMEOUT_SECONDS=5
RECONCILEFLOW_S3_READ_TIMEOUT_SECONDS=30
RECONCILEFLOW_S3_AUTO_CREATE_BUCKET=true
RECONCILEFLOW_PRESIGNED_URL_TTL_SECONDS=300
RECONCILEFLOW_ABANDONED_UPLOAD_RETENTION_HOURS=24
RECONCILEFLOW_MAX_UPLOAD_SIZE_BYTES=10485760
RECONCILEFLOW_TOKEN_SIGNING_SECRET=development-only-change-this-token-secret
RECONCILEFLOW_TOKEN_ISSUER=reconcileflow-api
RECONCILEFLOW_TOKEN_AUDIENCE=reconcileflow-clients
RECONCILEFLOW_ACCESS_TOKEN_TTL_MINUTES=15
RECONCILEFLOW_REFRESH_TOKEN_TTL_DAYS=30
RECONCILEFLOW_LOGIN_MAX_FAILED_ATTEMPTS=5
RECONCILEFLOW_LOGIN_LOCKOUT_MINUTES=15
RECONCILEFLOW_WORKER_ID=reconcileflow-worker
RECONCILEFLOW_WORKER_POLL_INTERVAL_SECONDS=2
RECONCILEFLOW_WORKER_STALE_TIMEOUT_SECONDS=300
RECONCILEFLOW_WORKER_RETRY_DELAY_SECONDS=30
RECONCILEFLOW_MAX_MANUAL_JOB_RETRIES=3
RECONCILEFLOW_WORKER_HEALTH_STALE_SECONDS=120
RECONCILEFLOW_SUCCEEDED_JOB_RETENTION_DAYS=30
RECONCILEFLOW_FAILED_JOB_RETENTION_DAYS=90
RECONCILEFLOW_CANCELLED_JOB_RETENTION_DAYS=30
RECONCILEFLOW_WORKER_RECORD_RETENTION_DAYS=7
RECONCILEFLOW_CLEANUP_BATCH_SIZE=500
RECONCILEFLOW_DEFAULT_JOB_TIMEOUT_SECONDS=900
RECONCILEFLOW_MAXIMUM_JOB_TIMEOUT_SECONDS=3600
RECONCILEFLOW_JOB_PRIORITY_AGING_SECONDS=300
