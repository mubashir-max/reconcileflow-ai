# Copy this file to .env when local configuration is required.
# Never place real credentials or secrets in this template.

RECONCILEFLOW_ENVIRONMENT=development
RECONCILEFLOW_DEBUG=false
RECONCILEFLOW_API_PREFIX=/api/v1
RECONCILEFLOW_LOG_LEVEL=INFO
RECONCILEFLOW_DATABASE_URL=postgresql+psycopg://reconcileflow:change-me@localhost:5432/reconcileflow
RECONCILEFLOW_DATABASE_ECHO=false
RECONCILEFLOW_DATABASE_POOL_SIZE=5
RECONCILEFLOW_DATABASE_MAX_OVERFLOW=10
RECONCILEFLOW_DATABASE_POOL_TIMEOUT_SECONDS=30
RECONCILEFLOW_UPLOAD_DIRECTORY=var/uploads
RECONCILEFLOW_MAX_UPLOAD_SIZE_BYTES=10485760
