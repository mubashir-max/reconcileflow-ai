# Copy this file to .env.docker before starting Docker Compose.
# These values are only for local development. Never reuse them in production.

POSTGRES_DB=reconcileflow
POSTGRES_USER=reconcileflow
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
API_PORT=8000

RECONCILEFLOW_ENVIRONMENT=development
RECONCILEFLOW_DEBUG=false
RECONCILEFLOW_LOG_LEVEL=INFO
RECONCILEFLOW_DATABASE_URL=postgresql+psycopg://reconcileflow:replace-with-a-local-password@db:5432/reconcileflow
RECONCILEFLOW_DATABASE_ECHO=false
RECONCILEFLOW_UPLOAD_DIRECTORY=/app/var/uploads
RECONCILEFLOW_MAX_UPLOAD_SIZE_BYTES=10485760
